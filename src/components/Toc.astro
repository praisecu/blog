---
const headings = Astro.props.headings ?? [];
const filtered = headings.filter((h) => h.depth === 2 || h.depth === 3);

function indent(depth) {
  return depth === 3 ? "14px" : "0px";
}
---

<!-- Desktop TOC -->
<nav class="toc toc-desktop" aria-label="Table of contents">
  <div class="toc-inner">
    <div class="toc-title">CONTENTS</div>

    {filtered.map((h) => (
      <a
        class="toc-link"
        href={`#${h.slug}`}
        style={`margin-left:${indent(h.depth)};`}
        data-toc-link
      >
        {h.text}
      </a>
    ))}
  </div>
</nav>

<!-- Mobile TOC (collapsible) -->
<details class="toc toc-mobile" aria-label="Table of contents">
  <summary class="toc-summary">
    <span class="toc-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 6h11M9 12h11M9 18h11"></path>
        <circle cx="4.5" cy="6" r="1.2" fill="currentColor" stroke="none"></circle>
        <circle cx="4.5" cy="12" r="1.2" fill="currentColor" stroke="none"></circle>
        <circle cx="4.5" cy="18" r="1.2" fill="currentColor" stroke="none"></circle>
      </svg>
    </span>
    <span class="toc-summary-text">
      <span class="toc-mobile-label">Contents</span>
      <span class="toc-current" data-toc-current>{filtered.filter((h) => h.depth === 2).length} sections</span>
    </span>
    <svg class="toc-chevron" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M6 9l6 6 6-6"></path>
    </svg>
  </summary>

  <div class="toc-mobile-body">
    {filtered.map((h) => (
      <a
        class="toc-link"
        href={`#${h.slug}`}
        data-depth={h.depth}
        data-toc-link
      >
        <span class="toc-text">{h.text}</span>
      </a>
    ))}
  </div>
</details>

<style>
  /* ------- Responsive TOC behavior ------- */
  .toc-desktop {
    display: block;

    /* Sticky sidebar that vertically centers its contents (desktop only). */
    position: sticky;
    top: 74px;
    height: calc(100vh - 74px);
    padding: 16px 0;

    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .toc-inner {
    max-height: calc(100vh - 106px);
    overflow: auto;
  }

  .toc-mobile {
    display: none;
  }

  @media (max-width: 980px) {
    .toc-desktop {
      display: none;
    }
    .toc-mobile {
      display: block;
    }

    .toc-summary {
      list-style: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding: 10px 12px;
      border-radius: 14px;
      user-select: none;
    }

    .toc-mobile summary::-webkit-details-marker {
      display: none;
    }

    .toc-chevron {
      opacity: 0.7;
      font-size: 14px;
      transform: rotate(0deg);
      transition: transform 120ms ease;
    }
    details[open] .toc-chevron {
      transform: rotate(180deg);
    }

    .toc-mobile-body {
      padding: 10px 4px 2px;
      max-height: 42vh;
      overflow: auto;
    }
  }

  /* ---------- Modern TOC look (theme-aware via CSS variables below) ---------- */

  /* Title */
  .toc-title {
    font-size: 16px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 600;
    margin: 0 0 12px;
    color: var(--toc-title);
    text-align: center;
    text-decoration: underline;
  }

  /* Desktop container: “card” */
  .toc-desktop .toc-inner {
    width: min(280px, 100%);
    border: 1px solid var(--toc-border);
    border-radius: 16px;
    background: var(--toc-bg);
    box-shadow: var(--toc-shadow);
    padding: 14px 12px;
    backdrop-filter: blur(10px);
  }

  /* Links */
  .toc-link {
    display: block;
    padding: 9px 10px 9px 12px;
    border-radius: 12px;
    text-decoration: none;
    font-size: 16px;
    line-height: 1.25;
    color: var(--toc-link);
    transition: background 140ms ease, color 140ms ease, transform 140ms ease;
    margin: 2px 0;
  }

  /* Hover */
  .toc-link:hover {
    background: var(--toc-link-hover-bg);
    color: var(--toc-link-hover);
    transform: translateY(-1px);
  }

  /* Active = pill + subtle border */
  .toc-link.is-active {
    background: var(--toc-active-bg);
    color: var(--toc-link-hover);
    font-weight: 750;
    outline: 1px solid var(--toc-active-outline);
    box-shadow: var(--toc-active-shadow);
  }

  /* Better hierarchy for depth=3 items */
  .toc-link[style*="margin-left:14px"] {
    font-size: 14px;
    color: color-mix(in srgb, var(--toc-link) 88%, transparent);
  }

  /* Scroll polish */
  .toc-inner {
    scrollbar-width: thin; /* Firefox */
    scrollbar-color: var(--toc-scroll-thumb) transparent;
  }
  .toc-inner::-webkit-scrollbar {
    width: 10px;
  }
  .toc-inner::-webkit-scrollbar-thumb {
    background: var(--toc-scroll-thumb);
    border-radius: 999px;
    border: 3px solid transparent;
    background-clip: content-box;
  }
  .toc-inner::-webkit-scrollbar-thumb:hover {
    background: var(--toc-scroll-thumb-hover);
    border: 3px solid transparent;
    background-clip: content-box;
  }

  /* Mobile: one clean card with an icon, the current section, and a numbered list */
  @media (max-width: 980px) {
    .toc-mobile {
      border: 1px solid var(--toc-border);
      background: var(--toc-bg);
      border-radius: 18px;
      padding: 0;
      box-shadow: var(--toc-shadow);
      backdrop-filter: blur(10px);
      margin: 4px 0 20px;
      overflow: hidden;
    }

    .toc-summary {
      justify-content: flex-start;
      gap: 12px;
      min-height: 44px;
      padding: 12px 14px;
      border-radius: 0;
      background: none;
      -webkit-tap-highlight-color: transparent;
    }
    .toc-summary:focus-visible { outline: 2px solid var(--toc-accent); outline-offset: -2px; border-radius: 18px; }

    .toc-icon {
      flex: 0 0 auto;
      display: grid;
      place-items: center;
      width: 36px;
      height: 36px;
      border-radius: 11px;
      color: var(--toc-accent);
      background: var(--toc-active-bg);
    }

    .toc-summary-text { flex: 1 1 auto; min-width: 0; }
    .toc-mobile-label {
      display: block;
      font-size: 15px;
      font-weight: 700;
      line-height: 1.2;
      color: var(--toc-link-hover);
    }
    .toc-current {
      display: block;
      margin-top: 2px;
      overflow: hidden;
      font-size: 13px;
      line-height: 1.25;
      color: var(--toc-title);
      white-space: nowrap;
      text-overflow: ellipsis;
    }

    .toc-chevron {
      flex: 0 0 auto;
      opacity: 0.6;
      color: var(--toc-link-hover);
      transition: transform 180ms ease;
    }
    details[open] .toc-chevron { transform: rotate(180deg); }

    .toc-mobile-body {
      counter-reset: toc-sec;
      max-height: 55vh;
      padding: 6px 8px 10px;
      overflow: auto;
      border-top: 1px solid var(--toc-border);
      animation: toc-in 160ms ease-out;
    }
    .toc-mobile-body .toc-link {
      display: flex;
      align-items: center;
      gap: 12px;
      min-height: 44px;
      margin: 2px 0;
      padding: 8px 10px;
      font-size: 15px;
      border-left: 0;
      border-radius: 12px;
      outline: none;
      box-shadow: none;
    }
    .toc-mobile-body .toc-link:hover { transform: none; }
    .toc-mobile-body .toc-link[data-depth="2"]::before {
      counter-increment: toc-sec;
      content: counter(toc-sec);
      flex: 0 0 auto;
      display: grid;
      place-items: center;
      width: 26px;
      height: 26px;
      font-size: 12px;
      font-weight: 700;
      font-variant-numeric: tabular-nums;
      color: var(--toc-title);
      background: var(--toc-summary-bg);
      border-radius: 999px;
    }
    .toc-mobile-body .toc-link[data-depth="3"] { padding-left: 48px; font-size: 14px; }
    .toc-mobile-body .toc-link.is-active {
      font-weight: 650;
      background: var(--toc-active-bg);
      outline: none;
      box-shadow: none;
    }
    .toc-mobile-body .toc-link.is-active::before { color: #1d1e00; background: var(--toc-accent); }

    @keyframes toc-in { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }
    @media (prefers-reduced-motion: reduce) {
      .toc-mobile-body { animation: none; }
      .toc-chevron { transition: none; }
    }
  }

  /* ---------------- Theme variables (Light + Dark) ---------------- */
  :root {
    --toc-bg: rgb(255, 255, 255);
    --toc-border: var(--border);
    --toc-shadow: 0 10px 30px rgba(20, 20, 20, 0.06);

    --toc-title: rgba(22, 22, 22, 0.55);

    --toc-link: rgba(15, 23, 42, 0.72);
    --toc-link-hover-bg: rgba(24, 24, 24, 0.04);
    --toc-link-hover: rgba(32, 32, 32, 0.92);

    --toc-active-bg: rgba(238, 178, 0, 0.29);
    --toc-active-outline: rgba(234, 179, 8, 0.35);
    --toc-active-shadow: 0 6px 16px rgba(234, 179, 8, 0.18);

    --toc-scroll-thumb: rgba(27, 27, 27, 0.14);
    --toc-scroll-thumb-hover: rgba(29, 29, 29, 0.22);

    --toc-summary-bg: rgba(26, 26, 26, 0.05);
    --toc-accent: #a8862b;
  }

  /* Your toggle sets document.documentElement.dataset.theme = "dark" */
  :root[data-theme="dark"] {
    --toc-bg: rgba(22, 22, 22, 0.55); /* dark glass */
    --toc-border: rgba(148, 163, 184, 0.18);
    --toc-shadow: 0 12px 36px rgba(0, 0, 0, 0.45);

    --toc-title: rgba(226, 232, 240, 0.55);

    --toc-link: rgba(226, 232, 240, 0.72);
    --toc-link-hover-bg: rgba(226, 232, 240, 0.06);
    --toc-link-hover: rgba(226, 232, 240, 0.92);

    --toc-active-bg: rgba(234, 179, 8, 0.16);
    --toc-active-outline: rgba(234, 179, 8, 0.45);
    --toc-active-shadow: 0 10px 26px rgba(234, 179, 8, 0.12);

    --toc-scroll-thumb: rgba(226, 232, 240, 0.18);
    --toc-scroll-thumb-hover: rgba(226, 232, 240, 0.28);

    --toc-summary-bg: rgba(226, 232, 240, 0.08);
    --toc-accent: #cfb87c;
  }
</style>

<script is:inline>
  // The TOC sits before the article, so wait for the headings to exist before observing them.
  const initToc = () => {
    // We have 2 TOCs on the page (desktop + mobile). Collect all links.
    const links = Array.from(document.querySelectorAll("a[data-toc-link]"));
    if (!links.length) return;

    const targets = links
      .map((a) => {
        const href = a.getAttribute("href");
        if (!href || !href.startsWith("#")) return null;
        const id = decodeURIComponent(href.slice(1));
        return document.getElementById(id);
      })
      .filter(Boolean);

    const clear = () => links.forEach((a) => a.classList.remove("is-active"));

    const current = document.querySelector("[data-toc-current]");
    const setActiveById = (id) => {
      if (!id) return;
      clear();
      for (const a of links) {
        const hid = decodeURIComponent(a.getAttribute("href").slice(1));
        if (hid === id) {
          a.classList.add("is-active");
          // Show the section you are reading in the collapsed mobile summary
          if (current && a.closest(".toc-mobile")) current.textContent = a.textContent.trim();
        }
      }
    };

    // Close mobile accordion after clicking a link
    links.forEach((a) => {
      a.addEventListener("click", () => {
        const details = a.closest("details.toc-mobile");
        if (details) details.removeAttribute("open");

        const href = a.getAttribute("href");
        if (href && href.startsWith("#"))
          setActiveById(decodeURIComponent(href.slice(1)));
      });
    });

    if (location.hash) setActiveById(decodeURIComponent(location.hash.slice(1)));

    window.addEventListener("hashchange", () => {
      if (location.hash) setActiveById(decodeURIComponent(location.hash.slice(1)));
    });

    const io = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);

        if (visible.length) setActiveById(visible[0].target.id);
      },
      { root: null, rootMargin: "-18% 0px -72% 0px", threshold: 0.01 }
    );

    // De-dup targets (because links repeat in desktop+mobile)
    const uniq = Array.from(new Set(targets));
    uniq.forEach((t) => io.observe(t));
  };
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", initToc);
  else initToc();
</script>

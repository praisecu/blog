---
/**
 * Interactive widgets for the panorama-stitching tutorial.
 * Usage in MDX:  <PanoWidget kind="harris" />
 * kinds: harris | anms | match | ransac | blend
 * Markup only - behaviour lives in ../scripts/pano-widgets.js, data in
 * ../data/pano-data.json (both generated by public/code/gen_pano.py).
 */
const { kind } = Astro.props;
const base = (import.meta.env.BASE_URL || "/").replace(/\/?$/, "/");
const img = (name) => `${base}images/pano/${name}`;
---

{kind === "harris" && (
  <div id="w-harris" class="pano-widget" data-img={img("left.jpg")}>
    <div class="pano-stage"></div>
    <div class="pano-controls">
      <span class="pano-endlabel">keep&nbsp;everything</span>
      <input type="range" min="0" max="100" value="55" />
      <span class="pano-endlabel">strongest&nbsp;only</span>
    </div>
    <div class="pano-readout"></div>
  </div>
)}

{kind === "anms" && (
  <div id="w-anms" class="pano-widget" data-img={img("left.jpg")}>
    <div class="pano-stage"></div>
    <div class="pano-controls">
      <span class="pano-endlabel">N&nbsp;=&nbsp;10</span>
      <input type="range" min="10" max="800" value="300" step="5" />
      <span class="pano-endlabel">N&nbsp;=&nbsp;800</span>
      <label class="pano-radio"><input type="radio" name="anmsmode" value="top" /> top-N by strength</label>
      <label class="pano-radio"><input type="radio" name="anmsmode" value="anms" checked /> ANMS</label>
    </div>
    <div class="pano-readout"></div>
  </div>
)}

{kind === "match" && (
  <div id="w-match" class="pano-widget" data-img-l={img("left.jpg")} data-img-r={img("right.jpg")}>
    <div class="pano-stage"></div>
    <div class="pano-controls">
      <span class="pano-endlabel">strict&nbsp;(0.55)</span>
      <input type="range" min="55" max="93" value="80" />
      <span class="pano-endlabel">lenient&nbsp;(0.93)</span>
      <label class="pano-radio"><input type="checkbox" /> reveal outliers</label>
    </div>
    <div class="pano-readout"></div>
  </div>
)}

{kind === "ransac" && (
  <div id="w-ransac" class="pano-widget" data-img-l={img("left.jpg")} data-img-r={img("right.jpg")}>
    <div class="pano-stage"></div>
    <div class="pano-controls">
      <button type="button" class="pano-btn pano-spin">Run one iteration</button>
      <button type="button" class="pano-btn pano-spin10">Run ×10</button>
      <button type="button" class="pano-btn pano-reset">↺ Reset</button>
    </div>
    <div class="pano-readout"></div>
  </div>
)}

{kind === "blend" && (
  <div id="w-blend" class="pano-widget">
    <div class="pano-ba">
      <img src={img("10-final.jpg")} alt="feathered final panorama" />
      <div class="pano-ba-top"><img src={img("hard-crop.jpg")} alt="hard-cut composite" /></div>
      <div class="pano-ba-line"></div>
    </div>
    <div class="pano-controls">
      <span class="pano-endlabel">⬅&nbsp;hard&nbsp;cut</span>
      <input type="range" min="0" max="100" value="50" />
      <span class="pano-endlabel">feathered&nbsp;➡</span>
    </div>
    <div class="pano-readout">Slide to move the divider across the panorama.</div>
  </div>
)}

<style is:global>
  .pano-widget {
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 14px 16px 12px;
    margin: 1.6em 0 2em;
    background: var(--card);
  }
  .pano-stage { line-height: 0; }
  .pano-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: 12px;
    font-size: 0.85em;
    color: var(--muted);
  }
  .pano-controls input[type="range"] {
    flex: 1 1 140px;
    min-width: 120px;
    accent-color: var(--brand-gold);
  }
  .pano-endlabel { white-space: nowrap; font-size: 0.9em; }
  .pano-radio { white-space: nowrap; margin: 0; font-weight: 600; cursor: pointer; }
  .pano-radio input { margin-right: 4px; }
  .pano-readout {
    margin-top: 10px;
    font-size: 0.9em;
    color: var(--fg);
    background: var(--bg);
    border: 1px dashed var(--border);
    border-radius: 6px;
    padding: 7px 12px;
    min-height: 1.5em;
  }
  .pano-btn {
    background: var(--brand-gold);
    color: var(--bg);
    border: none;
    border-radius: 6px;
    padding: 8px 14px;
    font-size: 0.95em;
    font-weight: 700;
    cursor: pointer;
  }
  .pano-btn:hover { background: var(--brand-gold-2); }
  .pano-quiz {
    background: var(--brand-wash);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 10px 16px;
    margin: 1.4em 0;
  }
  .pano-quiz summary { cursor: pointer; font-weight: 700; outline: none; }
  .pano-quiz p { margin: 0.8em 0 0.3em; }
  .pano-ba {
    position: relative; overflow: hidden; line-height: 0; border-radius: 6px;
    width: fit-content; max-width: 100%; margin: 0 auto;
  }
  .pano-ba > img { max-width: 100%; max-height: 70vh; width: auto; display: block; }
  .pano-ba-top {
    position: absolute; top: 0; left: 0; height: 100%;
    width: 50%; overflow: hidden;
  }
  .pano-ba-top img { display: block; height: 100%; width: auto; max-width: none; }
  .pano-ba-line {
    position: absolute; top: 0; left: 50%; width: 3px; height: 100%;
    background: #fff; box-shadow: 0 0 5px rgba(0,0,0,0.65);
    pointer-events: none;
  }
  figure.pano-figure { margin: 1.4em 0; }
  figure.pano-figure img {
    max-width: 100%;
    max-height: 70vh;        /* keep tall (portrait) figures from filling the screen */
    width: auto;
    display: block;
    margin: 0 auto;
    border-radius: 6px;
  }
  figure.pano-figure.pano-narrow img { max-width: 504px; }
  figure.pano-figure figcaption {
    font-size: 0.88em;
    color: var(--muted);
    font-style: italic;
    margin-top: 6px;
    text-align: center;
  }
</style>

<script>
  import { initPanoWidgets } from "../scripts/pano-widgets.js";
  import PANO_DATA from "../data/pano-data.json";
  initPanoWidgets(PANO_DATA);
</script>

---
// The main site's header (src/_includes/components/modern-header.njk in
// praisecu.github.io), plus a Blog link. Keep the two in step when the main
// site's navigation changes, including the Openings badge.
---

<header class="modern-header">
  <div class="modern-header__inner">
    <a class="modern-header__brand" href="/" aria-label="PRAISe Lab home">
      <img
        class="modern-header__logo"
        src="/img/logo/boulder.webp"
        alt="University of Colorado Boulder"
      />
      <span class="modern-header__name">PRAISe Lab</span>
    </a>

    <button
      class="theme-toggle theme-toggle--mobile"
      type="button"
      data-theme-toggle
      aria-label="Switch to dark mode"
      aria-pressed="false"
      title="Switch to dark mode"
    >
      <span class="theme-toggle__track" aria-hidden="true">
        <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="3.5"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"></path>
        </svg>
        <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24">
          <path d="M20 15.2A8.5 8.5 0 0 1 8.8 4a8.5 8.5 0 1 0 11.2 11.2Z"></path>
        </svg>
        <span class="theme-toggle__thumb"></span>
      </span>
      <span class="theme-toggle__label">Switch to dark mode</span>
    </button>

    <nav
      id="modern-header-navigation"
      class="modern-header__navigation"
      aria-label="Primary navigation"
    >
      <button
        class="theme-toggle theme-toggle--desktop"
        type="button"
        data-theme-toggle
        aria-label="Switch to dark mode"
        aria-pressed="false"
        title="Switch to dark mode"
      >
        <span class="theme-toggle__track" aria-hidden="true">
          <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="3.5"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"></path>
          </svg>
          <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24">
            <path d="M20 15.2A8.5 8.5 0 0 1 8.8 4a8.5 8.5 0 1 0 11.2 11.2Z"></path>
          </svg>
          <span class="theme-toggle__thumb"></span>
        </span>
        <span class="theme-toggle__label">Switch to dark mode</span>
      </button>

      <div class="modern-header__dropdown">
        <button
          class="modern-header__link modern-header__dropdown-button"
          type="button"
          aria-expanded="false"
        >
          Research
          <i class="fa fa-caret-down" aria-hidden="true"></i>
        </button>

        <div class="modern-header__dropdown-menu">
          <a href="/research-areas.html">Research Areas</a>
          <a href="/publications.html">Recent Publications</a>
        </div>
      </div>

      <a class="modern-header__link" href="/teaching.html">Teaching</a>
      <a class="modern-header__link" href="/team.html">Team</a>
      <a class="modern-header__link" href="/media.html">Media</a>
      <a class="modern-header__link is-active" href="/blog/">Blog</a>
      <a class="modern-header__link" href="/openings.html">
        Openings
        <span class="nav-badge">New</span>
      </a>
    </nav>
  </div>
</header>

<nav class="mobile-bottom-nav" aria-label="Mobile navigation">
  <a class="mobile-bottom-nav__item" href="/">
    <i class="fa fa-home" aria-hidden="true"></i>
    <span>Home</span>
  </a>

  <a class="mobile-bottom-nav__item" href="/research-areas.html">
    <i class="fa fa-flask" aria-hidden="true"></i>
    <span>Research</span>
  </a>

  <a class="mobile-bottom-nav__item" href="/teaching.html">
    <i class="fa fa-graduation-cap" aria-hidden="true"></i>
    <span>Teaching</span>
  </a>

  <a class="mobile-bottom-nav__item" href="/team.html">
    <i class="fa fa-users" aria-hidden="true"></i>
    <span>Team</span>
  </a>

  <button
    class="mobile-bottom-nav__item mobile-bottom-nav__more is-active"
    type="button"
    aria-expanded="false"
    aria-controls="mobile-more-menu"
  >
    <i class="fa fa-ellipsis-h" aria-hidden="true"></i>
    <span>More</span>
    <span class="nav-badge-dot" aria-hidden="true"></span>
  </button>
</nav>

<div id="mobile-more-menu" class="mobile-more-menu" aria-hidden="true">
  <button
    class="mobile-more-menu__backdrop"
    type="button"
    aria-label="Close navigation menu"
  ></button>

  <div
    class="mobile-more-menu__panel"
    role="dialog"
    aria-modal="true"
    aria-label="More navigation links"
  >
    <div class="mobile-more-menu__handle"></div>

    <div class="mobile-more-menu__heading">
      <span>More</span>
      <button class="mobile-more-menu__close" type="button" aria-label="Close menu">
        <i class="fa fa-times" aria-hidden="true"></i>
      </button>
    </div>

    <div class="mobile-more-menu__links">
      <a href="/blog/">
        <i class="fa fa-pencil" aria-hidden="true"></i>
        <span>Blog</span>
      </a>
      <a href="/publications.html">
        <i class="fa fa-book" aria-hidden="true"></i>
        <span>Publications</span>
      </a>
      <a href="/media.html">
        <i class="fa fa-camera" aria-hidden="true"></i>
        <span>Media</span>
      </a>
      <a href="/openings.html">
        <i class="fa fa-briefcase" aria-hidden="true"></i>
        <span>Openings <b class="nav-badge">New</b></span>
      </a>
    </div>
  </div>
</div>

<style is:global>
  /* A full-height body would release the sticky header after one screen. */
  html,
  body {
    height: auto !important;
  }

  body {
    min-height: 100vh;
  }

  /* Headings reached from the contents list clear the sticky header. */
  html {
    scroll-padding-top: 90px;
  }

  /* The blog's reading defaults must not leak into the header. */
  .modern-header,
  .mobile-bottom-nav,
  .mobile-more-menu {
    hyphens: manual;
    letter-spacing: normal;
    line-height: 1.3;
    font-size: 16px;
  }

  /* Theme toggle, from the main site's css/dark-mode.css. That file also
     restyles whole pages in dark mode, so only the toggle is carried over. */
  .modern-header__inner {
    position: relative;
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 68px;
    height: 34px;
    padding: 0;
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .theme-toggle__track {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 68px;
    height: 34px;
    padding: 0 8px;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.28);
    border: 1px solid rgba(207, 185, 125, 0.34);
    border-radius: 999px;
    transition:
      background-color 180ms ease,
      border-color 180ms ease;
  }

  .theme-toggle__icon {
    position: relative;
    z-index: 2;
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.1;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: color 180ms ease;
  }

  .theme-toggle__icon--sun {
    color: #1d1e00;
  }

  .theme-toggle__icon--moon {
    color: rgba(255, 255, 255, 0.38);
  }

  .theme-toggle__thumb {
    position: absolute;
    z-index: 1;
    top: 2px;
    left: 2px;
    width: 28px;
    height: 28px;
    background: #cfb97d;
    border: 1px solid #cfb97d;
    border-radius: 50%;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.45);
    transition:
      transform 180ms ease,
      background-color 180ms ease;
  }

  html[data-theme="dark"] .theme-toggle__thumb {
    transform: translateX(34px);
  }

  html[data-theme="dark"] .theme-toggle__icon--sun {
    color: rgba(255, 255, 255, 0.38);
  }

  html[data-theme="dark"] .theme-toggle__icon--moon {
    color: #1d1e00;
  }

  .theme-toggle:hover .theme-toggle__track,
  .theme-toggle:focus-visible .theme-toggle__track {
    background: rgba(255, 255, 255, 0.09);
    border-color: rgba(207, 185, 125, 0.6);
  }

  .theme-toggle:focus-visible {
    outline: 2px solid #cfb97d;
    outline-offset: 3px;
  }

  .theme-toggle__label {
    position: absolute;
    overflow: hidden;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    border: 0;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .theme-toggle--desktop {
    margin-right: 3px;
  }

  .theme-toggle--mobile {
    display: none;
  }

  @media (max-width: 900px) {
    .theme-toggle--desktop {
      display: none !important;
    }

    .theme-toggle--mobile {
      position: absolute;
      top: 50%;
      right: 14px;
      z-index: 2;
      display: inline-flex;
      transform: translateY(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle__track,
    .theme-toggle__thumb,
    .theme-toggle__icon {
      transition: none;
    }
  }
</style>
